# ==========================================
# Runtime Evidence Snapshots & Databases
# ==========================================
# Ignore dynamically generated violation snapshots during runtime
evidence_snapshots/*.jpg
evidence_snapshots/*.png
!evidence_snapshots/.gitkeep

# Ignore SQLite local runtime database (re-generated on seed)
*.db
*.sqlite3

# Ignore user-uploaded custom videos
**/uploaded_traffic.mp4
backend/ai_engine/

